/* ================= SECTION 1: FEATURED KITCHENS ================= */
.featured-section {
    padding: 60px 8%;
    background-color: #0b0b0b;
}

.featured-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 30px;
}

.view-all-link {
    color: #f5a623;
    font-size: 15px;
    font-weight: 600;
    transition: color 0.3s ease;
}

.view-all-link:hover {
    color: #e0951b;
}

.featured-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.featured-card {
    background-color: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

.card-image-wrapper {
    position: relative;
    width: 100%;
    height: 180px;
    background-color: #222;
}

.card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.card-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background-color: #f5a623;
    color: #1a1a1a;
    font-size: 11px;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    z-index: 2;
}

.card-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex-grow: 1;
}

.card-title {
    font-size: 20px;
    font-weight: 700;
    color: #ffffff;
}

.card-meta {
    display: flex;
    justify-content: space-between;
    font-size: 14px;
    color: #b3b3b3;
    margin-bottom: 10px;
}

.rating {
    color: #f5a623;
    font-weight: 600;
}

.order-btn {
    background-color: #f5a623;
    color: #1a1a1a;
    border: none;
    padding: 12px 20px;
    border-radius: 50px;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    font-family: 'Poppins', sans-serif;
    width: 100%;
    transition: background 0.3s ease;
    margin-top: auto;
}

.order-btn:hover {
    background-color: #e0951b;
}

/* ================= SECTION 2: WHY CAMPUSEATS ================= */
