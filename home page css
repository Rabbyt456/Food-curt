/* ================= SECTION 3: CTA ================= */
.cta-section {
    padding: 60px 8%;
    background-color: #0b0b0b;
}

.cta-box {
    position: relative;
    background: linear-gradient(135deg, #2a1a00 0%, #1a1100 100%);
    border: 1px solid #3a2500;
    border-radius: 24px;
    padding: 60px 50px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 300px;
}

.cta-subtitle {
    font-size: 13px;
    font-weight: 700;
    color: #f5a623;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 15px;
    display: block;
}

.cta-title {
    font-size: 42px;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.2;
    margin-bottom: 20px;
}

.cta-desc {
    font-size: 16px;
    color: #b3b3b3;
    margin-bottom: 30px;
    max-width: 500px;
    line-height: 1.6;
}

.cta-buttons {
    display: flex;
    align-items: center;
    gap: 20px;
}

.cta-circle-icon {
    position: absolute;
    top: 40px;
    right: 60px;
    font-size: 40px;
    background-color: rgba(245, 166, 35, 0.1);
    width: 80px;
    height: 80px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(245, 166, 35, 0.3);
}

.cta-small-icon {
    position: absolute;
    bottom: 40px;
    right: 120px;
    font-size: 28px;
    background-color: rgba(255, 255, 255, 0.05);
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.1);
