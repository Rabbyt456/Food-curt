/* ================= RESPONSIVE FOR NEW SECTIONS ================= */
@media (max-width: 1024px) {
    .featured-grid,
    .why-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    .cta-title {
        font-size: 34px;
    }
    .cta-circle-icon {
        top: 30px;
        right: 30px;
        width: 60px;
        height: 60px;
        font-size: 30px;
    }
    .cta-small-icon {
        bottom: 30px;
        right: 80px;
        width: 50px;
        height: 50px;
        font-size: 22px;
    }
}

@media (max-width: 768px) {
    .featured-grid,
    .why-grid {
        grid-template-columns: 1fr;
    }
    .featured-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
    }
    .cta-box {
        padding: 40px 25px;
    }
    .cta-title {
        font-size: 28px;
    }
    .cta-buttons {
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
    }
    .cta-circle-icon,
    .cta-small-icon {
        display: none; /* Hide decorative icons on small screens */
    }
}
