/* Reset and Base Styles */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Poppins', sans-serif;
}

body {
    background-color: #cbaaaa;
    overflow-x: hidden; /* Prevent horizontal scroll from the character image */
}

/* Header Container */
.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 8%; /* Adjust padding to match the spacing in the screenshot */
    background-color: #3e1903;
    width: 100%;
    height: 90px; /* Approximate header height */
}

 /* background page  */

 /* ===== HERO SECTION ===== */
.hero-section {
    position: relative;
    min-height: 90vh;
    display: flex;
    align-items: center;
    padding: 60px 80px;
    background-image: url('campusfood.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    overflow: hidden;
}

/* Dark overlay — picture er upore kalo layer */
.hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.65);  /* 0.65 = 65% kalo */
    z-index: 1;
}

/* Content ta overlay er upore thakbe */
.hero-content {
    position: relative;
    z-index: 2;
    max-width: 600px;
    color: #fff;
}





/* Logo Styling */
.logo {
    font-size: 28px;
    font-weight: 700;
    color: #b9820b; /* Golden yellow color */
    letter-spacing: 0.5px;
}

/* Navigation Menu Styling */
.nav-menu {
    display: flex;
    gap: 45px; /* Space between navigation links */
    margin-left: 50px; /* Slight offset to center the menu */
}

.nav-link {
    text-decoration: none;
    color: #333333;
    font-size: 16px;
    font-weight: 500;
    transition: color 0.3s ease;
}

.nav-link:hover {
    color: #f5b027;
}

/* Right Side Actions (Cart + Sign In) */
.header-actions {
    display: flex;
    align-items: center;
    gap: 25px; /* Space between cart and sign-in button */
}

/* Cart Icon and Badge */
.cart-container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
}

.cart-icon {
    font-size: 22px;
    color: #1a1a1a;
}

.cart-badge {
    position: absolute;
    top: -8px;
    right: -10px;
    background-color: #f5b027;
    color: #1a1a1a;
    font-size: 11px;
    font-weight: 700;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #ffffff; /* White border to separate from icon */
}

/* Sign In Button Styling */
.sign-in-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    background-color: #f5b027;
    color: #ffffff;
    text-decoration: none;
    padding: 10px 24px;
    border-radius: 25px;
    font-size: 15px;
    font-weight: 600;
    transition: background-color 0.3s ease;
}

.sign-in-btn:hover {
    background-color: #e09e1f;
}

.sign-in-icon {
    font-size: 14px;
}

/* Hero Section (Bottom Image Area) */
.hero-section {
    width: 100%;
    display: flex;
    justify-content: flex-end; /* Align image to the right side */
    padding-right: 12%; /* Adjust to position the image horizontally */
    margin-top: 10px;
}

/* Character Image Styling */
.character-img {
    width: 200px; /* Adjust width based on your actual image */
    height: auto;
    object-fit: contain;
    /* If you don't have an image yet, this will display a broken image icon. 
       Replace 'character-placeholder.png' in the HTML with your actual file. */
}

/* Responsive Adjustments */
@media (max-width: 1024px) {
    .header {
        padding: 20px 5%;
    }
    .nav-menu {
        gap: 25px;
        margin-left: 0;
    }
}

@media (max-width: 768px) {
    .header {
        flex-wrap: wrap;
        height: auto;
        padding: 15px 5%;
        gap: 15px;
    }
    .nav-menu {
        order: 3;
        width: 100%;
        justify-content: center;
        gap: 15px;
        margin-top: 10px;
    }
    .nav-link {
        font-size: 14px;
    }
    .header-actions {
        gap: 15px;
    }
    .sign-in-btn {
        padding: 8px 16px;
        font-size: 14px;
    }
    .logo {
        font-size: 24px;
    }
    .hero-section {
        justify-content: center;
        padding-right: 0;
    }
}



