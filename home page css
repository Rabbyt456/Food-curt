/* ============================================
   CAMPUSEATS - HOME PAGE CSS
   ============================================ */

/* ================= RESET ================= */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Poppins', sans-serif;
}

html {
    scroll-behavior: smooth;
}

body {
    background-color: #0b0b0b;
    color: #ffffff;
    overflow-x: hidden;
    line-height: 1.6;
    margin: 0;
    padding: 0;
}

a {
    text-decoration: none;
    color: inherit;
}

img {
    max-width: 100%;
    display: block;
}

/* ================= NAVBAR / HEADER ================= */
.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 40px;
    background-color: #341a1a;
    border-bottom: 1px solid #222;
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
}

/* ===== Logo ===== */
/* ===== Logo ===== */
.logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 22px;
    font-weight: 800;
    color: #e0d9d9;
    letter-spacing: -0.3px;
    flex-shrink: 0;
}

.logo-icon {
    color: #ff6b00;
    font-size: 24px;
}

/* ===== Nav Menu ===== */
.nav-menu {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
}

.nav-link {
    text-decoration: none;
    color: #838181;
    font-size: 15px;
    font-weight: 500;
    padding: 8px 18px;
    border-radius: 50px;
    transition: color 0.3s ease, background-color 0.3s ease;
    white-space: nowrap;
}

.nav-link:hover {
    color: #e0d9d9;
}

/* ===== Active Link (Home) ===== */
.nav-link.active {
    background-color: #ff6b00;
    color: #ffffff;
    font-weight: 700;
    padding: 8px 22px;
}

.nav-link.active:hover {
    background-color: #e05e00;
    color: #ffffff;
}

/* ===== Right Side Actions ===== */
.header-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-shrink: 0;
}

/* Cart */
.cart-container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
}

.cart-icon {
    font-size: 22px;
    color: #e0d9d9;
    transition: color 0.3s ease;
}

.cart-container:hover .cart-icon {
    color: #ff6b00;
}

.cart-badge {
    position: absolute;
    top: -8px;
    right: -10px;
    background-color: #ff6b00;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #341a1a;
}

/* ===== Sign In Button ===== */
.sign-in-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 24px;
    border: 1px solid #222;
    border-radius: 50px;
    font-size: 15px;
    font-weight: 600;
    color: #e0d9d9;
    text-decoration: none;
    background: transparent;
    transition: border-color 0.3s ease, background-color 0.3s ease;
    white-space: nowrap;
}

.sign-in-btn:hover {
    border-color: #ff6b00;
    background-color: rgba(255, 107, 0, 0.1);
}

.sign-in-icon {
    font-size: 14px;
}

/* ================= HERO SECTION ================= */
.hero-section {
    position: relative;
    width: 100%;
    min-height: 75vh;
    background-color: #0b0b0b;
    background-image: url('image/canteenhome.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    align-items: center;
    padding: 60px 8%;
    overflow: hidden;
}

.hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.65);
    z-index: 1;
}

.hero-content {
    position: relative;
    z-index: 2;
    max-width: 650px;
    width: 100%;
    color: #ffffff;
    text-align: left;
}

.availability-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: #ffffff;
    background-color: rgba(255, 165, 0, 0.15);
    border: 1px solid rgba(255, 165, 0, 0.3);
    padding: 6px 14px;
    border-radius: 50px;
    margin-bottom: 24px;
    letter-spacing: 0.3px;
}

.availability-badge .dot {
    width: 8px;
    height: 8px;
    background-color: #00c853;
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 10px #00c853;
}

.hero-title {
    font-size: 52px;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 20px;
    letter-spacing: -1px;
    color: #ffffff;
}

.hero-title .highlight {
    color: #f5a623;
}

.hero-desc {
    font-size: 16px;
    color: #b3b3b3;
    margin-bottom: 30px;
    max-width: 520px;
    line-height: 1.6;
}

.hero-buttons {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 30px;
    flex-wrap: wrap;
}

.btn-primary {
    background-color: #f5a623;
    color: #1a1a1a;
    padding: 12px 24px;
    border-radius: 50px;
    font-weight: 700;
    font-size: 15px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: background 0.3s ease, transform 0.2s ease;
    border: none;
    cursor: pointer;
    font-family: 'Poppins', sans-serif;
}

.btn-primary:hover {
    background-color: #e0951b;
    transform: translateY(-2px);
}

.btn-primary i {
    font-size: 14px;
}

.btn-secondary {
    color: #ffffff;
    font-weight: 600;
    font-size: 15px;
    transition: color 0.3s ease;
    text-decoration: underline;
    text-underline-offset: 4px;
}

.btn-secondary:hover {
    color: #f5a623;
}

.search-container {
    display: flex;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 50px;
    padding: 4px 4px 4px 20px;
    width: 100%;
    max-width: 450px;
    backdrop-filter: blur(10px);
}

.search-container input {
    background: transparent;
    border: none;
    outline: none;
    color: #ffffff;
    font-size: 14px;
    width: 100%;
    font-family: 'Poppins', sans-serif;
}

.search-container input::placeholder {
    color: #888888;
}

.search-btn {
    background-color: #f5a623;
    color: #1a1a1a;
    border: none;
    padding: 10px 24px;
    border-radius: 50px;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    font-family: 'Poppins', sans-serif;
    transition: background 0.3s ease;
}

.search-btn:hover {
    background-color: #e0951b;
}

/* ================= STATISTICS SECTION ================= */
.stats-section {
    background-color: #0d0d0d;
    border-top: 1px solid #222222;
    border-bottom: 1px solid #222222;
    display: flex;
    justify-content: space-around;
    padding: 30px 8%;
    width: 100%;
    flex-wrap: wrap;
    gap: 20px;
}

.stat-item {
    display: flex;
    align-items: center;
    gap: 15px;
}

.stat-icon {
    font-size: 28px;
    background: #1a1a1a;
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
}

.stat-info {
    display: flex;
    flex-direction: column;
}

.stat-number {
    font-size: 20px;
    font-weight: 700;
    color: #ffffff;
}

.stat-label {
    font-size: 13px;
    color: #888888;
    font-weight: 500;
}

/* ================= SECTION COMMON ================= */
.section-subtitle {
    font-size: 12px;
    font-weight: 700;
    color: #f5a623;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    display: block;
    margin-bottom: 8px;
}

.section-title {
    font-size: 32px;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 30px;
}

/* ================= CUISINE SECTION ================= */
.cuisine-section {
    padding: 60px 8%;
    background-color: #0b0b0b;
}

.cuisine-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 20px;
}

.cuisine-card {
    background-color: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 12px;
    padding: 25px 15px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    cursor: pointer;
    transition: background 0.3s ease, border-color 0.3s ease, transform 0.2s ease;
}

.cuisine-card:hover {
    background-color: #222222;
    border-color: #f5a623;
    transform: translateY(-4px);
}

.cuisine-emoji {
    font-size: 32px;
}

.cuisine-name {
    font-size: 14px;
    font-weight: 600;
    color: #ffffff;
}

/* ================= FEATURED KITCHENS ================= */
.featured-section {
    padding: 60px 8%;
    background-color: #0b0b0b;
}

.featured-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 30px;
    gap: 20px;
}

.view-all-link {
    color: #f5a623;
    font-size: 15px;
    font-weight: 600;
    transition: color 0.3s ease;
    white-space: nowrap;
}

.view-all-link:hover {
    color: #e0951b;
}

.featured-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.featured-card {
    background-color: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.3s ease, transform 0.2s ease;
}

.featured-card:hover {
    border-color: #f5a623;
    transform: translateY(-4px);
}

.card-image-wrapper {
    position: relative;
    width: 100%;
    height: 180px;
    background-color: #222;
}

.card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.card-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background-color: #f5a623;
    color: #1a1a1a;
    font-size: 11px;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    z-index: 2;
}

.card-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex-grow: 1;
}

.card-title {
    font-size: 20px;
    font-weight: 700;
    color: #ffffff;
}

.card-meta {
    display: flex;
    justify-content: space-between;
    font-size: 14px;
    color: #b3b3b3;
    margin-bottom: 10px;
}

.rating {
    color: #f5a623;
    font-weight: 600;
}

.order-btn {
    background-color: #f5a623;
    color: #1a1a1a;
    border: none;
    padding: 12px 20px;
    border-radius: 50px;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    font-family: 'Poppins', sans-serif;
    width: 100%;
    transition: background 0.3s ease;
    margin-top: auto;
}

.order-btn:hover {
    background-color: #e0951b;
}

/* ================= WHY CAMPUSEATS ================= */
.why-section {
    padding: 60px 8%;
    background-color: #0b0b0b;
    border-top: 1px solid #222;
}

.why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
    margin-top: 30px;
}

.why-card {
    background-color: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 16px;
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: background 0.3s ease, border-color 0.3s ease;
}

.why-card:hover {
    background-color: #222;
    border-color: #f5a623;
}

.why-icon {
    font-size: 28px;
    background-color: #252525;
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    margin-bottom: 5px;
}

.why-title {
    font-size: 18px;
    font-weight: 700;
    color: #ffffff;
}

.why-desc {
    font-size: 14px;
    color: #888888;
    line-height: 1.6;
}

/* ================= CTA SECTION ================= */
.cta-section {
    padding: 60px 8%;
    background-color: #0b0b0b;
}

.cta-box {
    position: relative;
    background: linear-gradient(135deg, #2a1a00 0%, #1a1100 100%);
    border: 1px solid #3a2500;
    border-radius: 24px;
    padding: 60px 50px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 300px;
}

.cta-subtitle {
    font-size: 13px;
    font-weight: 700;
    color: #f5a623;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 15px;
    display: block;
}

.cta-title {
    font-size: 42px;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.2;
    margin-bottom: 20px;
}

.cta-desc {
    font-size: 16px;
    color: #b3b3b3;
    margin-bottom: 30px;
    max-width: 500px;
    line-height: 1.6;
}

.cta-buttons {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
}

.cta-circle-icon {
    position: absolute;
    top: 40px;
    right: 60px;
    font-size: 40px;
    background-color: rgba(245, 166, 35, 0.1);
    width: 80px;
    height: 80px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(245, 166, 35, 0.3);
}

.cta-small-icon {
    position: absolute;
    bottom: 40px;
    right: 120px;
    font-size: 28px;
    background-color: rgba(255, 255, 255, 0.05);
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

/* ================= FOOTER ================= */
.footer {
    background-color: #0b0b0b;
    border-top: 1px solid #222222;
    padding: 50px 8%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 12px;
}

.footer-icon {
    font-size: 36px;
    margin-bottom: 5px;
}

.footer-logo {
    font-size: 24px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.5px;
}

.footer-copy {
    font-size: 14px;
    color: #888888;
    margin-bottom: 15px;
}

.footer-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 30px;
}

.footer-link {
    font-size: 14px;
    color: #b3b3b3;
    font-weight: 500;
    transition: color 0.3s ease;
}

.footer-link:hover {
    color: #f5a623;
}

/* ================= RESPONSIVE ================= */
@media (max-width: 1024px) {
    .header {
        padding: 15px 5%;
    }
    .nav-menu {
        gap: 4px;
    }
    .nav-link {
        padding: 6px 12px;
        font-size: 14px;
    }
    .hero-title {
        font-size: 42px;
    }
    .cuisine-grid {
        grid-template-columns: repeat(3, 1fr);
    }
    .featured-grid,
    .why-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    .cta-title {
        font-size: 34px;
    }
    .cta-circle-icon {
        top: 30px;
        right: 30px;
        width: 60px;
        height: 60px;
        font-size: 30px;
    }
    .cta-small-icon {
        bottom: 30px;
        right: 80px;
        width: 50px;
        height: 50px;
        font-size: 22px;
    }
}

@media (max-width: 768px) {
    .header {
        flex-wrap: wrap;
        padding: 15px 5%;
        gap: 12px;
    }
    .nav-menu {
        order: 3;
        width: 100%;
        justify-content: center;
        gap: 6px;
        margin-top: 10px;
    }
    .nav-link {
        font-size: 13px;
        padding: 6px 14px;
    }
    .nav-link.active {
        padding: 6px 16px;
    }
    .logo {
        font-size: 18px;
    }
    .sign-in-btn {
        padding: 8px 16px;
        font-size: 13px;
    }
    .hero-section {
        padding: 40px 5%;
        min-height: 60vh;
    }
    .hero-title {
        font-size: 34px;
    }
    .hero-buttons {
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
    }
    .search-container {
        max-width: 100%;
    }
    .stats-section {
        flex-direction: column;
        align-items: flex-start;
        padding: 30px 5%;
    }
    .cuisine-section,
    .featured-section,
    .why-section,
    .cta-section {
        padding: 40px 5%;
    }
    .cuisine-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    .featured-grid,
    .why-grid {
        grid-template-columns: 1fr;
    }
    .featured-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
    }
    .cta-box {
        padding: 40px 25px;
    }
    .cta-title {
        font-size: 28px;
    }
    .cta-buttons {
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
    }
    .cta-circle-icon,
    .cta-small-icon {
        display: none;
    }
    .footer {
        padding: 40px 5%;
    }
    .footer-logo {
        font-size: 20px;
    }
    .footer-links {
        gap: 20px;
    }
}



/* ============================================
   KITCHEN PAGE SPECIFIC CSS
   ============================================ */

/* ================= KITCHEN HERO BANNER ================= */
.kitchen-hero {
    position: relative;
    width: 100%;
    min-height: 400px;
    background-image: url('images/canteen.jpg');
    background-size: cover;
    background-position: center;
    border-radius: 0 0 24px 24px;
    overflow: hidden;
    display: flex;
    align-items: center;
    padding: 60px 8%;
}

.kitchen-hero-overlay {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: linear-gradient(to right, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.5) 60%, rgba(0,0,0,0.2) 100%);
    z-index: 1;
}

.kitchen-hero-content {
    position: relative;
    z-index: 2;
    max-width: 600px;
}

.kitchen-hero-subtitle {
    font-size: 12px;
    font-weight: 700;
    color: #f5a623;
    letter-spacing: 2px;
    text-transform: uppercase;
    display: block;
    margin-bottom: 15px;
}

.kitchen-hero-title {
    font-size: 42px;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.2;
    margin-bottom: 15px;
    letter-spacing: -1px;
}

.kitchen-hero-desc {
    font-size: 15px;
    color: #b3b3b3;
    margin-bottom: 30px;
}

/* Floating Chips */
.kitchen-chips {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
}

.kitchen-chip {
    background-color: rgba(20, 15, 12, 0.85);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(245, 166, 35, 0.3);
    border-radius: 50px;
    padding: 8px 16px 8px 10px;
    display: flex;
    align-items: center;
    gap: 10px;
    transition: transform 0.2s ease, border-color 0.3s ease;
}

.kitchen-chip:hover {
    transform: translateY(-3px);
    border-color: #f5a623;
}

.chip-icon {
    width: 32px;
    height: 32px;
    background-color: #f5a623;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
}

.kitchen-chip div {
    display: flex;
    flex-direction: column;
}

.kitchen-chip strong {
    font-size: 13px;
    color: #ffffff;
    font-weight: 600;
    line-height: 1.2;
}

.kitchen-chip span {
    font-size: 11px;
    color: #f5a623;
}

/* ================= FILTER SECTION ================= */
.filter-section {
    padding: 30px 8%;
    background-color: #0b0b0b;
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.filter-row {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
}

.filter-search {
    flex: 1;
    min-width: 250px;
    background-color: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 12px;
    padding: 12px 18px;
    display: flex;
    align-items: center;
    gap: 12px;
}

.filter-search i {
    color: #888;
    font-size: 15px;
}

.filter-search input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: #ffffff;
    font-size: 14px;
    font-family: 'Poppins', sans-serif;
}

.filter-search input::placeholder {
    color: #666;
}

/* Toggle */
.filter-toggle {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    user-select: none;
}

.filter-toggle input {
    display: none;
}

.toggle-slider {
    width: 42px;
    height: 24px;
    background-color: #2a2a2a;
    border-radius: 50px;
    position: relative;
    transition: background-color 0.3s ease;
    flex-shrink: 0;
}

.toggle-slider::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 20px;
    height: 20px;
    background-color: #ffffff;
    border-radius: 50%;
    transition: transform 0.3s ease;
}

.filter-toggle input:checked + .toggle-slider {
    background-color: #00c853;
}

.filter-toggle input:checked + .toggle-slider::after {
    transform: translateX(18px);
}

.toggle-label {
    font-size: 14px;
    color: #b3b3b3;
    font-weight: 500;
    white-space: nowrap;
}

/* Cuisine Tags */
.cuisine-tags {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

.tag {
    background-color: #1a1a1a;
    border: 1px solid #2a2a2a;
    color: #b3b3b3;
    padding: 8px 18px;
    border-radius: 50px;
    font-size: 13px;
    font-weight: 500;
    font-family: 'Poppins', sans-serif;
    cursor: pointer;
    transition: all 0.3s ease;
}

.tag:hover {
    border-color: #f5a623;
    color: #f5a623;
}

.tag.active {
    background-color: #f5a623;
    border-color: #f5a623;
    color: #1a1a1a;
    font-weight: 600;
}

/* ================= KITCHEN GRID ================= */
.kitchen-list {
    padding: 40px 8% 80px;
    background-color: #0b0b0b;
}

.kitchen-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.kitchen-card {
    background-color: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.3s ease, transform 0.2s ease;
}

.kitchen-card:hover {
    border-color: #f5a623;
    transform: translateY(-4px);
}

.kitchen-image-wrapper {
    position: relative;
    width: 100%;
    height: 200px;
    background-color: #222;
}

.kitchen-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.kitchen-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background-color: #f5a623;
    color: #1a1a1a;
    font-size: 11px;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    z-index: 2;
}

.fav-btn {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 36px;
    height: 36px;
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(10px);
    border: none;
    border-radius: 50%;
    color: #ffffff;
    font-size: 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: background 0.3s ease;
}

.fav-btn:hover {
    background-color: rgba(245, 166, 35, 0.9);
    color: #1a1a1a;
}

.kitchen-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex-grow: 1;
}

.kitchen-title-row {
    display: flex;
    align-items: center;
    gap: 12px;
}

.kitchen-icon-box {
    width: 40px;
    height: 40px;
    background-color: #f5a623;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    flex-shrink: 0;
}

.kitchen-title {
    font-size: 17px;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.2;
}

.kitchen-cuisine {
    font-size: 12px;
    color: #888;
    font-weight: 500;
}

.kitchen-info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    color: #888;
    gap: 10px;
    flex-wrap: wrap;
}

.kitchen-info {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.kitchen-distance {
    color: #b3b3b3;
    font-weight: 600;
}

.rating {
    color: #f5a623;
    font-weight: 600;
}

.time {
    color: #b3b3b3;
}

.status {
    font-size: 11px;
    font-weight: 600;
}

.status-open {
    color: #00c853;
}

.status-closed {
    color: #ff3b30;
}

.kitchen-menu {
    font-size: 12px;
    color: #888;
    line-height: 1.5;
    margin: 0;
}

.kitchen-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid #2a2a2a;
    gap: 10px;
    flex-wrap: wrap;
}

.delivery-tags {
    display: flex;
    gap: 10px;
}

.tag-delivery,
.tag-pickup {
    font-size: 11px;
    color: #b3b3b3;
    font-weight: 500;
}

.order-now-btn {
    background-color: #f5a623;
    color: #1a1a1a;
    padding: 8px 18px;
    border-radius: 50px;
    font-size: 13px;
    font-weight: 700;
    transition: background 0.3s ease;
    white-space: nowrap;
}

.order-now-btn:hover {
    background-color: #e0951b;
}

/* ================= RESPONSIVE ================= */
@media (max-width: 1024px) {
    .kitchen-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    .kitchen-hero-title {
        font-size: 34px;
    }
}

@media (max-width: 768px) {
    .kitchen-hero {
        padding: 40px 5%;
        min-height: 320px;
    }
    .kitchen-hero-title {
        font-size: 26px;
    }
    .kitchen-hero-desc {
        font-size: 13px;
    }
    .kitchen-chip {
        padding: 6px 12px 6px 8px;
    }
    .chip-icon {
        width: 26px;
        height: 26px;
        font-size: 13px;
    }
    .kitchen-chip strong {
        font-size: 11px;
    }
    .kitchen-chip span {
        font-size: 10px;
    }
    .filter-section {
        padding: 20px 5%;
    }
    .filter-row {
        flex-direction: column;
        align-items: stretch;
    }
    .kitchen-list {
        padding: 30px 5% 60px;
    }
    .kitchen-grid {
        grid-template-columns: 1fr;
    }
    .kitchen-hero {
        border-radius: 0;
    }
}
