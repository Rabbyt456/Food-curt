}

.btn-secondary {
    color: #ffffff;
    font-weight: 600;
    font-size: 15px;
    transition: color 0.3s ease;
}

.btn-secondary:hover {
    color: #f5a623;
}

.search-container {
    display: flex;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 50px;
    padding: 4px 4px 4px 20px;
    width: 100%;
    max-width: 450px;
}

.search-container input {
    background: transparent;
    border: none;
    outline: none;
    color: #ffffff;
    font-size: 14px;
    width: 100%;
    font-family: 'Poppins', sans-serif;
}

.search-container input::placeholder {
    color: #888888;
}

.search-btn {
    background-color: #f5a623;
    color: #1a1a1a;
    border: none;
    padding: 10px 24px;
    border-radius: 50px;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    font-family: 'Poppins', sans-serif;
    transition: background 0.3s ease;
}

.search-btn:hover {
    background-color: #e0951b;
}

/* ================= STATISTICS SECTION ================= */
.stats-section {
    background-color: #0d0d0d;
    border-top: 1px solid #222222;
    border-bottom: 1px solid #222222;
    display: flex;
    justify-content: space-around;
    padding: 30px 8%;
    width: 100%;
}

.stat-item {
    display: flex;
    align-items: center;
    gap: 15px;
}

.stat-icon {
    font-size: 28px;
    background: #1a1a1a;
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
}

.stat-info {
    display: flex;
    flex-direction: column;
}

.stat-number {
    font-size: 20px;
    font-weight: 700;
    color: #ffffff;
}

.stat-label {
    font-size: 13px;
    color: #888888;
    font-weight: 500;
}

/* ================= CUISINE SECTION ================= */
.cuisine-section {
    padding: 60px 8%;
    background-color: #0b0b0b;
}

.section-subtitle {
    font-size: 12px;
    font-weight: 700;
    color: #f5a623;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    display: block;
    margin-bottom: 8px;
}

.section-title {
    font-size: 32px;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 30px;
}

.cuisine-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 20px;
}

.cuisine-card {
    background-color: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 12px;
    padding: 25px 15px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    cursor: pointer;
    transition: background 0.3s ease, border-color 0.3s ease;
}

.cuisine-card:hover {
    background-color: #222222;
    border-color: #f5a623;
}

.cuisine-emoji {
    font-size: 32px;
}

.cuisine-name {
    font-size: 14px;
    font-weight: 600;
    color: #ffffff;
}

/* ================= RESPONSIVE ================= */
