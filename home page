    <!-- ================= ADD TO CART JAVASCRIPT ================= -->
    <!-- jQuery (AJAX এর জন্য দরকার) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
    $(document).ready(function() {
        // যখনই কোনো "Order Now" বাটনে ক্লিক হবে
        $('.add-to-cart').click(function(e) {
            e.preventDefault();
            
            // বাটন থেকে আইডি নাও
            var itemId = $(this).data('id');
            var button = $(this);
            
            // AJAX দিয়ে add_to_cart.php তে পাঠাও
            $.ajax({
                url: 'add_to_cart.php',
                type: 'POST',
                data: { item_id: itemId },
                success: function(response) {
                    // কার্টের নাম্বার আপডেট করো
                    $('#cart-count').text(response);
                    
                    // বাটনের রঙ পরিবর্তন করে ফিডব্যাক দাও
                    button.text('Added ✓').css('background-color', '#00c853');
                    
                    // ২ সেকেন্ড পর বাটন আগের অবস্থায় ফিরিয়ে আনো
                    setTimeout(function() {
                        button.text('Order Now →').css('background-color', '#f5a623');
                    }, 2000);
                },
                error: function() {
                    alert('Something went wrong! Check if add_to_cart.php exists.');
                }
            });
        });
    });
    </script>
